# ==============================================================================
# NSE Quant Platform Environment Configuration Template
# CRITICAL: Tokens & PINs must NEVER be stored here. Stored in OS Keyring or encrypted vault.
# ==============================================================================

# Fyers API v3 App Credentials
FYERS_APP_ID=YOUR_APP_ID-100
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=https://127.0.0.1:5000/

# Credential Storage Backend ('KEYRING' or 'ENCRYPTED_FILE')
AUTH_CREDENTIAL_STORAGE=KEYRING

# Database & Local Storage
DUCKDB_PATH=data/market_data.duckdb
EXPORT_DIR=data/exports

# Global RateGovernor Policy
RATE_GOVERNOR_BURST_PER_SEC=10
RATE_GOVERNOR_TARGET_PER_MIN=180
RATE_GOVERNOR_DAILY_CAP=90000

# Historical Ingestion Defaults
DEFAULT_1M_HISTORY_YEARS=5
DEFAULT_1D_HISTORY_YEARS=15

# Server & Logistics
LOG_LEVEL=INFO
UVICORN_WORKERS=1
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
